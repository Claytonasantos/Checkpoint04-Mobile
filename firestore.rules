rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só acessa os registros dentro do próprio UID:
    // usuarios/{uid}/registros/{registroId}
    match /usuarios/{uid}/registros/{registroId} {

      function ehDono() {
        return request.auth != null && request.auth.uid == uid;
      }

      function textoValido(campo, maximo) {
        return campo is string
          && campo.trim().size() > 0
          && campo.size() <= maximo;
      }

      function dadosValidos(dados) {
        return textoValido(dados.titulo, 100)
          && textoValido(dados.descricao, 500)
          && textoValido(dados.categoria, 50)
          && dados.prioridade in ['Baixa', 'Média', 'Alta'];
      }

      allow read, delete: if ehDono();

      // Só cria com os campos esperados e vinculado ao próprio UID
      allow create: if ehDono()
        && request.resource.data.keys().hasOnly([
          'titulo', 'descricao', 'categoria', 'prioridade',
          'uid', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && dadosValidos(request.resource.data);

      // Não permite trocar o dono nem a data de criação
      allow update: if ehDono()
        && request.resource.data.keys().hasOnly([
          'titulo', 'descricao', 'categoria', 'prioridade',
          'uid', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && dadosValidos(request.resource.data);
    }

    // Qualquer outro caminho fica bloqueado
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
